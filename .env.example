# ── SkinX RAG Backend — Environment Variables ────────────────────────────────

# Paths
CHUNKS_PATH=data/chunks/skinx_chunks.json
SYSTEM_PROMPT_PATH=data/system_prompt.md

# ChromaDB
CHROMA_PERSIST_DIR=data/chroma_db
CHROMA_COLLECTION_NAME=skinx_knowledge

# Embedding model
#   Default: Qwen/Qwen3-Embedding-8B
#   Lighter: Qwen/Qwen3-Embedding-4B
#   Lightest: Qwen/Qwen3-Embedding-0.6B  (1024 dimensions)
EMBEDDING_MODEL_NAME=Qwen/Qwen3-Embedding-0.6B

# Retrieval
TOP_K=5

# RAG API
RAG_PORT=8000
MAX_CONTEXT_CHARS=6000

# Debug mode
#   true  = /ask returns model name, token usage, distances, chunk IDs
#   false = /ask returns clean production JSON only
DEBUG_RAG=false

# OpenRouter LLM
#   Get your key at: https://openrouter.ai/keys
#   Primary model (openrouter/free routes to random free models)
#   Fallback model is used automatically if primary fails
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_FALLBACK_MODEL=google/gemma-4-26b-a4b-it-20260403:free
